<idea-plugin>
    <id>com.previewkit.idea</id>
    <name>PreviewKit</name>
    <vendor>PreviewKit</vendor>
    <description><![CDATA[
        PreviewKit IDE support: gutter navigation to generated <code>&lt;Name&gt;Preview.kt</code> files,
        <em>Regenerate Previews</em> action (runs the module's PreviewKit KSP task with progress)
        and inspections for <code>@WithPreview</code> (private functions, unsupported parameter types).
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="PreviewKit" displayType="BALLOON"/>
        <lineMarkerProvider language="kotlin"
                            implementationClass="com.previewkit.idea.gutter.WithPreviewLineMarkerProvider"/>
        <localInspection language="kotlin"
                         shortName="WithPreviewPrivateFunction"
                         displayName="@WithPreview on private function"
                         groupName="PreviewKit"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.previewkit.idea.inspection.PrivateWithPreviewInspection"/>
        <localInspection language="kotlin"
                         shortName="WithPreviewUnsupportedParameterType"
                         displayName="@WithPreview parameter not supported by last PreviewKit generation"
                         groupName="PreviewKit"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.previewkit.idea.inspection.UnsupportedParametersManifestInspection"/>
        <projectService serviceImplementation="com.previewkit.idea.manifest.UnsupportedManifestService"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
    <actions>
        <action id="com.previewkit.idea.action.RegeneratePreviewsAction"
                class="com.previewkit.idea.action.RegeneratePreviewsAction"
                text="Regenerate Previews"
                icon="/icons/previewkitPreview.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt P"/>
        </action>
        <action id="com.previewkit.idea.action.PreviewCoverageReportAction"
                class="com.previewkit.idea.action.PreviewCoverageReportAction"
                text="Preview Coverage Report">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift P"/>
        </action>
    </actions>
</idea-plugin>
